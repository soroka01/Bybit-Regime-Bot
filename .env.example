# Скопируйте в .env и заполните. Файл .env НЕ коммитить. Бот работает только на основной сети Bybit (mainnet, реальные деньги):
# переменных для выбора сети или режима без ордеров нет, а старые PAPER=1 и BYBIT_ENV=testnet остановят запуск с ошибкой (код 4).

# Токен бота от @BotFather в виде <число>:<строка> (формат проверяется при старте) и числовой id владельца (единственный, кто
# управляет ботом). Эти же две переменные читает tools/watchdog.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Ключ Bybit (Профиль -> API), оба значения обязательны. Права ТОЛЬКО Contract Orders + Positions (Trade). Право Withdraw НЕ
# включать: при старте бот проверяет ключ и блокирует торговлю, если право вывода есть или ключ только на чтение. Привязка по
# IP не требуется. Аккаунт - единый (UTA), изолированная маржа; проверить всё одной командой: python -m tradebot.app --check
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Часовой пояс для времени в сообщениях Telegram (по умолчанию Europe/Moscow)
TZ_NAME=Europe/Moscow
