# Скопируйте в .env и заполните. Файл .env НЕ коммитить.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# testnet (по умолчанию) | mainnet
BYBIT_ENV=testnet
BYBIT_API_KEY=
BYBIT_API_SECRET=
# для mainnet нужны ОБА: BYBIT_ENV=mainnet и I_UNDERSTAND_MAINNET=1
I_UNDERSTAND_MAINNET=0
# PAPER=1 (по умолчанию, если строки нет): режим только чтения. Бот считает сигналы, теневой P&L и читает
# кошелёк/позицию, но НЕ отправляет ни одного ордера и не меняет настройки аккаунта на бирже.
# Торговля возможна только при явном PAPER=0 (и перезапуске).
PAPER=1
# Часовой пояс для времени в сообщениях Telegram (по умолчанию Europe/Moscow)
TZ_NAME=Europe/Moscow
