# Copy to .env and fill in. Do NOT commit the .env file. The bot runs only on the Bybit main network (mainnet, real money):
# there are no variables for choosing a network or a no-orders mode, and the old PAPER=1 and BYBIT_ENV=testnet stop startup
# with an error (exit code 4).

# Language of the console, logs, `--check` report and the dashboard default: en (default) or ru. Any other value stops startup
# with an error (exit code 4). The Telegram bot interface is always Russian.
APP_LANGUAGE=en

# Bot token from @BotFather as <number>:<string> (the format is checked on startup) and the numeric id of the owner (the only
# person who controls the bot). The same two variables are read by tools/watchdog.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Bybit key (Profile -> API), both values are required. Permissions: ONLY Contract Orders + Positions (Trade). Do NOT enable
# Withdraw: on startup the bot checks the key and blocks trading if the withdrawal permission is present or the key is
# read-only. IP binding is not required. The account must be unified (UTA) with isolated margin; check everything with one
# command: python -m tradebot.app --check
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Time zone for the times shown in Telegram messages (default Europe/Moscow)
TZ_NAME=Europe/Moscow
